# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CHANNEL_NAME=events
REDIS_PASSWORD=your_secure_password_here

# Database Configuration
DATABASE_URL=postgresql://vms_admin:AIvan0987@db:5432/vms_analytics_db

# YOLO Configuration
YOLO_MODEL=yolov8n.pt

# Snapshot Configuration
SNAPSHOTS_DIR=/app/snapshots
ENABLE_SNAPSHOTS=true

# Location / GPS fetch (optional). If set, events will fetch latest GPS data from this base URL.
# Example: http://106.201.68.175:8001
# Leave empty or omit to disable location fetching.
LOCATION_FETCH_BASE_URL=

# API Configuration
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8069

